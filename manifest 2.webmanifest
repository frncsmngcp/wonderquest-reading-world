{
  "name": "WonderQuest: Reading World",
  "short_name": "WonderQuest",
  "description": "WonderQuest: Reading World: six reading adventures for online and offline learning — AWAD, Basa Tayo, Kuwento Tayo, Fluency Pyramid, Basa Bata Basa, and Letter Slide.",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#083e47",
  "theme_color": "#083e47",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest",
      "id": "./index.html"
    }
  ]
}
